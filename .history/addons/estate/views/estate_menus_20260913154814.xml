<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <menuitem id="estate_menu_root" name="Real Estate">

    <menuitem id="estate_first_level_menu" name="Properties">
        <menuitem id="estate_property_menu_action"
                  action="estate_property_action"/>
    </menuitem>

    <menuitem id="estate_property_type_menu"
              name="Property Types"
              action="estate_property_type_action"/>

    <menuitem id="estate_property_tag_menu"
              name="Property Tags"
              action="estate_property_tag_action"/>

    <menuitem id="estate_property_wizard_menu"
              name="Assistant"
              action="action_estate_property_wizard"/>

</menuitem>

    <record id="action_estate_property_wizard" model="ir.actions.act_window">
        <field name="name">Assistant</field>
        <field name="res_model">estate.property.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>